{
  "description": "baton: one fast check at session start (a line only when a worker CLI, login or lean profile is missing); one line of worker quota on every prompt",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/baton\" doctor --quick",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/quota-hint.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
